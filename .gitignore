# ── Data — raw and intermediate layers (regenerable) ─────────────
# data/bronze/* (not a trailing-slash dir pattern) so git still
# traverses the tree below, letting the negations re-include one file.
data/bronze/*
data/silver/
data/sql/

# Exception: ship the final consolidated trade_data / indicators_values
# bronze files so "Run Silver" and "Run Bronze" don't pay the full
# extraction time on every cold start of a cloud deployment (Comtrade /
# World Bank calls stay CLI-only or checkpointed per-run; per-batch
# files and .checkpoints/ stay git-ignored, only these two consolidated
# files are tracked, same rationale as data/gold/).
!data/bronze/trade_data/
data/bronze/trade_data/*
!data/bronze/trade_data/trade_data.csv

!data/bronze/indicators_values/
data/bronze/indicators_values/*
!data/bronze/indicators_values/indicators_values.csv
!data/bronze/indicators_values/.checkpoints/
data/bronze/indicators_values/.checkpoints/*
!data/bronze/indicators_values/.checkpoints/*.csv
!data/bronze/indicators_values/.checkpoints/*.done

# data/gold/     → committed (needed by analysis pages)
# data/resources/ → committed (reference CSVs used by pipeline)
# data/trade_analysis.duckdb → committed (36 MB, DuckDB backend)
# data/etl_status.json       → committed (ETL status page)
# data/known_divergences.json → committed
# data/sql/      → NOT committed (125 MB, duplicate pure-SQL DuckDB file,
#                   only used by Analysis/notebooks_sql, not read by the app)

